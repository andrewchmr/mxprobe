# Copy to /etc/mxprobe/env on the VPS (or server/.env locally).
PORT=8787
HOST=127.0.0.1
DB_PATH=/var/lib/mxprobe/mxprobe.sqlite
TRUST_PROXY=1
SITE_URL=https://mxprobe.dev
API_URL=https://api.mxprobe.dev

# Pricing (the plan: 100 free once, 9 USD per 10,000)
FREE_CREDITS=100
# A new key gets 0 free credits when its IP made a key in this many days (0 = off),
# or when its company domain (not free mail) has a key already (0 = off).
FREE_KEY_IP_DAYS=30
FREE_KEY_PER_DOMAIN=1
PACK_CREDITS=10000
PACK_USD=9
CHECKS_PER_MINUTE=60
SIGNUPS_PER_DAY_PER_IP=3
LOG_RETENTION_HOURS=24

# The probe identity. The reverse DNS of the VPS IP must be SMTP_HELO.
SMTP_HELO=probe.mxprobe.dev
SMTP_FROM=probe@mxprobe.dev
SMTP_CONCURRENCY=3

# Stripe: one product, one price (9 USD, quantity = packs of 10,000)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Resend, from a sender on mxprobe.dev
RESEND_API_KEY=
EMAIL_FROM="MX Probe <hello@mxprobe.dev>"

# Sequenzy (company "MX Probe", sender hello@emails.mxprobe.dev): the low-credit
# mail, once per key when credits drop below LOW_CREDITS, with the payment link.
# The copy lives in the Sequenzy template; it gets credits, buy_url, pack_credits, pack_usd.
SEQUENZY_API_KEY=
SEQUENZY_LOW_CREDITS_SLUG=credits-low
LOW_CREDITS=20

# Telegram operator pings (payment, low credits, subscriber, feedback, health)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PREFIX=[mxprobe]
