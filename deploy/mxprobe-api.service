[Unit]
Description=MX Probe API
After=network-online.target
Wants=network-online.target

[Service]
User=mxprobe
Group=mxprobe
WorkingDirectory=/opt/mxprobe/server
EnvironmentFile=/etc/mxprobe/env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/mxprobe/server/dist/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mxprobe
PrivateTmp=true

[Install]
WantedBy=multi-user.target
