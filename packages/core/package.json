{
  "name": "mxprobe-core",
  "version": "0.2.4",
  "description": "The MX Probe engine: DNS tier, SMTP probe and the send / hold / kill verdict contract. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewchmr/mxprobe.git",
    "directory": "packages/core"
  },
  "homepage": "https://mxprobe.dev",
  "keywords": [
    "email",
    "verification",
    "mx",
    "smtp",
    "bounce",
    "ai-agent",
    "mcp"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "test:live": "MXPROBE_LIVE=1 node --test test/*.live.ts",
    "prepack": "pnpm -w build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2"
  },
  "types": "./dist/index.d.ts"
}
