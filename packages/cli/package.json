{
  "name": "mxprobe",
  "version": "0.1.0",
  "description": "Email verification for AI agents. One call returns send, hold or kill with the reason. Free DNS tier runs locally; the hosted SMTP probe is 9 USD per 10,000 checks. CLI + MCP server.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mxprobe": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewchmr/mxprobe",
    "directory": "packages/cli"
  },
  "homepage": "https://mxprobe.dev",
  "keywords": [
    "email",
    "verification",
    "email-verifier",
    "mx",
    "smtp",
    "bounce",
    "ai-agent",
    "mcp",
    "mcp-server",
    "outreach"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mxprobe-core": "workspace:^",
    "zod": "^4.5.4"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "prepack": "pnpm -w build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2"
  }
}
